# Copy to .env before the first run. Nothing here is a real secret.

# Server
HOST=0.0.0.0
PORT=1337

# Any random strings work locally, but generate fresh ones for a deployment:
# node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
ENCRYPTION_KEY=replace-me

# sqlite locally, postgres on the deployed instance. For postgres, DATABASE_URL is enough:
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/railway
# DATABASE_SSL=true
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# The password the demo accounts are created with on boot. Unset means no demo accounts at all,
# and since a role cannot be picked at signup, that leaves no way in as anything but a Student.
SEED_PASSWORD=demo12345

# Origins allowed to call the API, comma separated. The deployed frontend URL goes here too.
FRONTEND_URLS=http://localhost:3000
