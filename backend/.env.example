HOST=0.0.0.0
PORT=1337

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Local development uses sqlite. Leaving DATABASE_FILENAME blank does not fall back to
# the default: env() only substitutes a missing variable, not an empty one, and the empty
# string resolves to the backend folder itself.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Production on Railway uses postgres, where DATABASE_URL comes from the database service.
# DATABASE_CLIENT=postgres
# DATABASE_URL=
# DATABASE_SSL=true

# Creates one demo account per role on boot, so each role can be signed in to. Unset means
# no accounts are created. Same value for all four; the README lists the emails.
SEED_PASSWORD=
