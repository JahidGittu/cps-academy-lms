# Copy to .env.local before the first run.

# Where Strapi is running. The /api prefix is added in lib/api.ts, so this is the host only.
# NEXT_PUBLIC_ because the browser is what calls it: auth is a bearer token held in localStorage,
# so the requests are made from the client, not from a Next server.
NEXT_PUBLIC_API_URL=http://localhost:1337
